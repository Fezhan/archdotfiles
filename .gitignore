# Ignore everything
*

# Unignore .gitignore and other root-level configs
!.gitignore
!.bashrc
!.gitconfig
!.installedpackages

# Unignore .config itself
!.config/

# Then unignore folders inside it
!.config/scripts/
!.config/scripts/*

# Your existing unignore rules
!.config/alacritty/
!.config/hypr/
!.config/i3/
!.config/icon-explorer/
!.config/lf/
!.config/mpvpaper/
!.config/ranger/
!.config/rofi/
!.config/sway/
!.config/swaylock/
!.config/swww/
!.config/sxhkd/
!.config/temp/waybar/
!.config/waybar/*
!.config/wofi/
!.config/dolphinrc
!.config/mimeapps.list
!.config/pavucontrol.ini
!.config/mpvpaper/*
!scripts/*

