;; weather
(defwidget weather []
	(box :class "genwin"
		(box :orientation "v" :spacing 10 :space-evenly "false" :vexpand "false" :hexpand "false"
			(box :orientation "h" :vexpand "false" :hexpand "false"
				(label :class "iconweather" :halign "start" :style "color: ${HEX};" :text ICON)
				(label :class "label_temp" :halign "end" :text TEMP))
			(box :orientation "v" :spacing 10 :halign "center" :space-evenly "false" :vexpand "false" :hexpand "false"
				(label :class "label_stat" :text STAT)
				(label :class "label_quote" :text QUOTE)
				(label :class "label_quote" :text QUOTE2)))))


;; weather
(defwindow weather :monitor 0 :exclusive "true" :stacking "bg" :focusable "true" :screen 1
	    :namespace "cutta" :geometry (geometry :x 880 :y 150 :width 700 :height 500)
					(weather))
