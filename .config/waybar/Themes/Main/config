{
	"layer": "top",
	"position": "top",
	"conditions": {
		"fullscreen": false
	},
	"modules-left": [
		"hyprland/workspaces",
		"custom/arrow10"
	],
	"modules-center": [
		"hyprland/window"
	],
	"modules-right": [
		"custom/arrow9",
		"pulseaudio",
		"custom/arrow8",
		"network",
		"custom/arrow13",
		"custom/pomodoro",
		"custom/arrow7",
		"memory",
		"custom/arrow6",
		"cpu",
		"custom/arrow5",
		"temperature",
		"custom/arrow4",
		"battery",
		"custom/arrow12",
		"custom/acer-power-profile",
		"custom/arrow3",
		"idle_inhibitor",
		"custom/arrow14",
		"custom/notification",
		"custom/arrow2",
		"tray",
		"clock#date",
		"custom/arrow1",
		"clock#time"
	],
	"battery": {
		"format": "{icon} ",
		"format-alt": "{capacity} % ",
		"format-alt-click": "click-right",
		"format-icons": [
			"\uf244",
			"\uf243",
			"\uf242",
			"\uf241",
			"\uf240"
		],
		"format-charging": "{capacity}% ⚡",
		"interval": 15,
		"states": {
			"warning": 25,
			"critical": 10
		},
		"tooltip": false
	},
	"clock#time": {
		"interval": 10,
		"format": "{:L%H:%M}",
		"timezone": "Europe/London",
		"tooltip": false
	},
	"clock#date": {
		"interval": 20,
		"format": "{:%e %B %Y}",
		"format-alt": "{:%a %d %b %Y}",
		"format-alt-click": "click-right",
		"tooltip": false,
		"tooltip-format": "{:%e %B %Y}"
	},
	"cpu": {
		"interval": 5,
		"tooltip": false,
		"format": "\uf4bc {usage}%",
		"format-alt": "\uf4bc {load}",
		"states": {
			"warning": 70,
			"critical": 90
		}
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "\udb80\udf3e",
			"deactivated": "\udb80\udf3f"
		},
		"tooltip": false,
		"start-activated": true
	},
	"memory": {
		"interval": 5,
		"format": "\uefc5  {used:0.1f}G",
		"format-alt": "\uefc5  {swapUsed:0.1f}G",
		"format-alt-click": "click-right",
		"states": {
			"warning": 70,
			"critical": 90
		},
		"tooltip": false
	},
	"network": {
		"interval": 10,
		"format-wifi": "{icon}  {essid} ({signalStrength}%)",
		"format-ethernet": "{icon} {ifname}",
		"format-disconnected": "No connection",
		"format-alt": "{ipaddr}/{cidr}  ({bandwidthUpBits} | {bandwidthDownBits})",
		"format-alt-click": "click-right",
		"format-icons": {
			"wifi": [
				"\udb82\udd2f",
				"\udb82\udd1f",
				"\udb82\udd22",
				"\udb82\udd25",
				"\udb82\udd28"
			],
			"ethernet": [
				"\udb80\ude01"
			],
			"disconnected": [
				"\udb81\uddaa"
			]
		},
		"tooltip": false,
		"on-click": "nm-connection-editor"
	},
	"custom/acer-power-profile": {
		"exec": "~/.config/waybar/modules/acerpowerprofiles.sh",
		"interval": 0,
		"signal": 8,
		"return-type": "json",
		"on-click": "~/.config/waybar/modules/acerpowerprofiles.sh toggle",
		"format": "{text} ",
		"format-alt": "{alt}",
		"format-alt-click": "click-right",
		"tooltip": true
	},
	"custom/notification": {
              "tooltip": false,
              "format": "{icon}",
              "format-icons": {
                   	"notification": "󱅫",
					"none": "󰂜",
					"dnd-notification": "󰂠",
					"dnd-none": "󰪓",
					"inhibited-notification": "󰂛",
					"inhibited-none": "󰪑",
					"dnd-inhibited-notification": "󰂛",
					"dnd-inhibited-none": "󰪑"
              },
              "return-type": "json",
              "exec-if": "which swaync-client",
              "exec": "swaync-client -swb",
              "on-click": "swaync-client -t -sw",
              "on-click-right": "swaync-client -d -sw",
              "escape": true
    },
	"custom/pomodoro": {
		"format": "{}",
		"return-type": "json",
		"exec": "waybar-module-pomodoro",
		"on-click": "waybar-module-pomodoro toggle",
		"on-click-right": "waybar-module-pomodoro reset",
	},
	"hyprland/window": {
		"max-length": 80,
		"tooltip": false,
		"format": "{}",
		"rewrite": {
			"(.*) — Mozilla Firefox": "$1",
			"(.*) — Microsoft Edge": "$1"
		},
		"separate-outputs": true
	},
	"hyprland/workspaces": {
		"persistent-workspaces": {
			"*": [
				1,
				3,
				5,
				9
			]
		},
		"format": "{name}",
		"disable-scroll": true
	},
	"pulseaudio": {
		"format": "{icon}",
		"format-alt": "{volume} {icon}",
		"format-alt-click": "click-right",
		"format-muted": "󰝟",
		"format-icons": {
			"phone": [
				" ",
				" ",
				" "
			],
			"default": [
				"",
				"",
				""
			]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol",
		"tooltip": false
	},
	"temperature": {
		"critical-threshold": 90,
		"interval": 5,
		"format": "{icon} {temperatureC}°",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"tooltip": false
	},
	"tray": {
		"icon-size": 18
	},
	"custom/youtubemusic": {
		"interval": 5,
		"max-length": 500,
		"return-type": "json",
		"exec": "/home/handesh/.config/waybar/modules/./youtubemusic.sh",
		"escape": true,
		"format": "{}",
		"on-click": "playerctl previous",
		"on-click-middle": "playerctl play-pause",
		"on-click-right": "playerctl next"
	},
	"custom/arrow1": {
		"format": "",
		"tooltip": false
	},
	"custom/arrow2": {
		"format": "",
