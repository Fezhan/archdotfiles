{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/youtubemusic", "pulseaudio", "network", "battery", "clock", "tray"],
    "hyprland/language": {
        "format": "{}",
	"interval": 1,
	"format-gb": "Ol'reliable",
	"format-en": "turning on the hax",
	"keyboard-name": "at-translated-set-2-keyboard"
    },
    "hyprland/workspaces": {
	"persistent-workspaces": {
	  "*": [ 1, 3, 5, 9],
	},
        "format": "{name}",
        "disable-scroll": true
    },
    "hyprland/window": {
        "max-length": 80,
        "tooltip": false,
	"format": "{}",
	"rewrite": {
        	"(.*) — Mozilla Firefox": "$1",
		"(.*) - Microsoft Edge": "$1",
		
		/*Enter any suffixes here to remove them*/
	},
	"separate-outputs": true
    },
    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip": false
    },
    "battery": {
        "format": "{capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""],
        "format-charging": "{capacity}% ⚡",
        "interval": 30,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip": false
    },
    "network": {
        "format": "{icon}",
        "format-alt": "{ipaddr}/{cidr} {icon}",
        "format-alt-click": "click-right",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": ["󰈁"],
            "disconnected": ["󰤮"]
        },
        "on-click": "nm-connection-editor",
    "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-alt": "{volume} {icon}",
        "format-alt-click": "click-right",
        "format-muted": "󰝟",
        "format-icons": {
            "phone": [" ", " ", " "],
            "default": ["", "", ""]
        },
        "scroll-step": 10,
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "custom/youtubemusic": {
	"interval": 1,
        "return-type": "json",
        "exec": "/home/faiyaz/.config/waybar/modules/youtubemusic.sh",
        "exec-if": "ps aux | pgrep -f 'chromium'",
        "escape": true,
	"format": "{}",
	"on-click": "playerctl previous",
	"on-click-middle": "playerctl play-pause",
	"on-click-right": "playerctl next"
    },
    "custom/storage": {
        "format": "{} ",
        "format-alt": "{percentage}% ",
        "format-alt-click": "click-right",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/modules/storage.sh"
    },
    
    "custom/mail": {
        "format": "",
        "format-alt": "{alt} ",
        "format-alt-click": "click-right",
        "interval": 60,
        "return-type": "json",
        "exec": "~/.config/waybar/modules/mail.py",
        "tooltip": false
    },
    "custom/test": {
        "format": "{}",
        "exec": "/tmp/test blub",
        "param": "blah",
        "interval": 5
    },
    "tray": {
        "icon-size": 18
    }
}
