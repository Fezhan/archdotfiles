#!/usr/bin/bash

# Directory containing wallpapers
wallpaper_dir="$HOME/.config/awww/wallpapers"

# File to store the index of the last wallpaper used
index_file="$HOME/.last_wallpaper_index"

# Get the list of wallpapers sorted alphabetically
mapfile -t wallpapers < <(ls -1 "$wallpaper_dir" | sort)

# Total number of wallpapers
total=${#wallpapers[@]}

# Read last index (default to -1 if file doesn't exist or is invalid)
if [[ -f "$index_file" && $(<"$index_file") =~ ^[0-9]+$ ]]; then
    last_index=$(<"$index_file")
else
    last_index=-1
fi

# Get the next index in sequence
next_index=$(( (last_index + 1) % total ))

# Get the next wallpaper path
wallpaper="$wallpaper_dir/${wallpapers[$next_index]}"

# Apply the wallpaper with swww
awww img "$wallpaper" \
    --transition-bezier 0.5,1.19,.8,.4 \
    --transition-type wave \
    --transition-duration 2 \
    --transition-fps 75

# Save the new index
echo "$next_index" > "$index_file"

