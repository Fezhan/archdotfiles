#!/usr/bin/env bash

# Set strict mode
set -euo pipefail

# -------------------------------------------------------------------
# Configuration
# -------------------------------------------------------------------
REPO_PATH="$HOME/Projects/autocommit"
REMOTE_NAME="origin"
BRANCH_NAME="main"
PAUSE_FILE_NAME=".pause_git_check"
PAUSE_FILE="$REPO_PATH/$PAUSE_FILE_NAME"
GITIGNORE_FILE="$REPO_PATH/.gitignore"
PAUSE_DURATION_SECONDS=86400  # 24 hours in seconds

# Move to the repository directory
cd "$REPO_PATH" || exit 1

# -------------------------------------------------------------------
# Check for Active Pause
# -------------------------------------------------------------------
if [ -f "$PAUSE_FILE" ]; then
    PAUSE_TIME=$(cat "$PAUSE_FILE")
    NOW_TIME=$(date +%s)
    ELAPSED=$(( NOW_TIME - PAUSE_TIME ))

    if [ "$ELAPSED" -lt "$PAUSE_DURATION_SECONDS" ]; then
        # Still paused, exit silently
        exit 0
    else
        # Pause period expired, clean up the state file
        rm -f "$PAUSE_FILE"
    fi
fi

# -------------------------------------------------------------------
# Check for local changes
# -------------------------------------------------------------------
if [ -z "$(git status --porcelain)" ]; then
    # No changes, exit cleanly
    exit 0
fi

# -------------------------------------------------------------------
# Dispatch Notification with Actions
# -------------------------------------------------------------------
ACTION=$(notify-send \
    --app-name="Git Tracker" \
    --urgency=normal \
    --action="custom=Write Custom Message" \
    --action="timestamp=Commit with Date/Time" \
    --action="pause=Pause for 1 Day" \
    --action="ignore=Ignore" \
    "Uncommitted Git Changes" \
    "Local changes detected in $(basename "$REPO_PATH"). What would you like to do?")

# Helper function to stage, commit, and push
commit_and_push() {
    local msg="$1"
    git add -A
    if git commit -m "$msg"; then
        if git push "$REMOTE_NAME" "$BRANCH_NAME"; then
            notify-send "Git Tracker" "Successfully committed and pushed changes."
        else
            notify-send -u critical "Git Tracker" "Failed to push changes to remote."
        fi
    else
        notify-send -u critical "Git Tracker" "Failed to make git commit."
    fi
}

# -------------------------------------------------------------------
# Handle User Selection
# -------------------------------------------------------------------
case "$ACTION" in
    "custom")
        COMMIT_MSG=$(zenity --entry \
            --title="Your Commit Message" \
            --text="Enter commit message for $(basename "$REPO_PATH"):" \
            --entry-text="WIP")

        if [ -n "$COMMIT_MSG" ]; then
            commit_and_push "$COMMIT_MSG"
        fi
        ;;

    "timestamp")
        NOW=$(date '+%Y-%m-%d %H:%M:%S')
        commit_and_push "auto: $NOW"
        ;;

    "pause")
        # Ensure .pause_git_check is ignored in .gitignore
        if [ ! -f "$GITIGNORE_FILE" ] || ! grep -qxF "$PAUSE_FILE_NAME" "$GITIGNORE_FILE"; then
            echo "$PAUSE_FILE_NAME" >> "$GITIGNORE_FILE"
        fi

        # Save current Unix timestamp to pause file
        date +%s > "$PAUSE_FILE"
        notify-send "Git Tracker" "Notifications paused for $(basename "$REPO_PATH") for 24 hours."
        ;;

    "ignore"|*)
        exit 0
        ;;
esac
